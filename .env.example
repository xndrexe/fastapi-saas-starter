# База данных. В prod — Postgres через asyncpg, в dev/tests — aiosqlite.
SAAS_DATABASE_URL=postgresql+asyncpg://saas:saas@postgres:5432/saas

# JWT-секрет. Минимум 32 символа. Поменять в проде на случайные байты.
SAAS_JWT_SECRET=change-me-in-prod-32-chars-min-please-12345
SAAS_JWT_ALGORITHM=HS256

# Время жизни токенов.
SAAS_ACCESS_TOKEN_LIFETIME_MIN=30
SAAS_REFRESH_TOKEN_LIFETIME_DAYS=14

# Ограничение частоты на auth-эндпоинтах (login/register/refresh).
SAAS_RATELIMIT_AUTH_PER_MINUTE=5

# bcrypt cost factor. 12 — компромисс между скоростью и стойкостью к подбору.
SAAS_BCRYPT_ROUNDS=12

# Запуск.
SAAS_HOST=0.0.0.0
SAAS_PORT=8000
SAAS_DEBUG=false
